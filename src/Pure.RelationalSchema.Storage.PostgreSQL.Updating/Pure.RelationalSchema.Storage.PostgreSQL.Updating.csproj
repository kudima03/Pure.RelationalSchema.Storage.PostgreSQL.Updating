<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0-preview.0.2.0</PackageValidationBaselineVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Pure.RelationalSchema.Storage.PostgreSQL.Updating</PackageId>
    <RootNamespace>Pure.RelationalSchema.Storage.PostgreSQL.Updating</RootNamespace>
    <AssemblyName>Pure.RelationalSchema.Storage.PostgreSQL.Updating</AssemblyName>
    <Authors>Dmitry Kurochkin</Authors>
    <Description>PostgreSQL row updating for the Pure relational schema ecosystem — UPDATE decorators over Pure.RelationalSchema.Storage.PostgreSQL.Querying datasets.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/kudima03/Pure.RelationalSchema.Storage.PostgreSQL.Updating</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pure.Collections.Generic" Version="0.1.0-preview.3.1.0" />
    <PackageReference Include="Pure.Linq.Conditions" Version="0.1.0-preview.0.4.0" />
    <PackageReference Include="Pure.Primitives" Version="3.8.0" />
    <PackageReference Include="Pure.Primitives.Abstractions" Version="4.4.0" />
    <PackageReference Include="Pure.Primitives.Choices" Version="1.4.0" />
    <PackageReference Include="Pure.Primitives.String.Operations" Version="1.8.0" />
    <PackageReference Include="Pure.RelationalSchema.HashCodes" Version="3.4.0" />
    <PackageReference
      Include="Pure.RelationalSchema.Storage.Abstractions"
      Version="0.1.0-preview.4.2.0"
    />
    <PackageReference
      Include="Pure.RelationalSchema.Storage.PostgreSQL.Abstractions"
      Version="0.1.0-preview.0.2.0"
    />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pure.RelationalSchema.Storage.PostgreSQL.Updating.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
